<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older. Paired with android:allowBackup="false", so this is a
  belt-and-braces statement rather than the thing doing the work.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
